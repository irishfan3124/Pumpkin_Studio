{
  "name": "pumpkin-studio",
  "version": "1.1.0",
  "description": "Browser-based printable pumpkin designer",
  "scripts": {
    "test": "node --test face-fit.test.mjs file-export.test.mjs worker-loader.test.mjs batch-export.test.mjs batch-job.test.mjs && node test.mjs",
    "build": "node build.mjs",
    "dev": "node server.mjs",
    "ios:assets": "node ios-assets.mjs",
    "ios:sync": "npm run build && npm run ios:assets && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "pngjs": "^7.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
